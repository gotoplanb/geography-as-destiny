# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# OS files
.DS_Store

# IDE
.vscode/
.idea/
# build/ tracked — epub and print interior available for download
# but inspection artifacts and intermediate build files are not
build/build/
build/epub_inspect/
build/temp_chapters/
build/metadata.yaml
# print cover pipeline: generated art, CMYK PDF, and the Adobe ICC profile
# (downloaded by cover/build_cover.py) stay out of git; the proof JPEG,
# the job/params record, and the print-ready PDF are tracked.
build/cover/*
!build/cover/cover-proof.jpg
!build/cover/jobs.json
!build/cover/geography-as-destiny-cover.pdf
